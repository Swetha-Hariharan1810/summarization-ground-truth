# Copy to .env and fill in. .env is git-ignored.

# --- LLM provider -------------------------------------------------------------
# "openai" (api.openai.com or an OpenAI-compatible base URL) or "azure" (Azure OpenAI).
# Patient call data: use a provider and account covered by your BAA.
LLM_PROVIDER=openai

# provider=openai
OPENAI_API_KEY=
# Optional, for a gateway or proxy:
OPENAI_BASE_URL=

# provider=azure  (model names below are then deployment names)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Models -------------------------------------------------------------------
# Labeller writes the evidence-cited record. Use your strongest GPT model.
LABELLER_MODEL=
# Judge checks the rendered summary. Must differ from the labeller.
JUDGE_MODEL=
# Second, cheaper pass over the closed-set fields only.
CLOSED_SET_MODEL=
# Optional: low | medium | high, sent only to models that support reasoning effort.
LABELLER_REASONING_EFFORT=
JUDGE_REASONING_EFFORT=

# --- Preprocessing ------------------------------------------------------------
# Path to the summarization service's src/ directory. The serving preprocessing is
# imported from there so labels are made from exactly what the model will see.
SUMM_SERVICE_SRC=../summarization-service/src

# --- Run settings -------------------------------------------------------------
MAX_CONCURRENCY=4
MAX_LABEL_ATTEMPTS=2
REQUEST_TIMEOUT_SECONDS=300
